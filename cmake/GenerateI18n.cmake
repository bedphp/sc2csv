# Turns src/i18n/*.csv into a C++ include with the language names and the raw tables.
#
# Called by CMakeLists.txt as:
#   cmake -DI18N_SOURCE_DIR=<dir> -DI18N_OUTPUT=<file.inc> -P cmake/GenerateI18n.cmake
#
# Only the metadata ($lang, $name, $order) is interpreted here; the CSV body is embedded verbatim between raw
# string delimiters and parsed by src/i18n.cpp at startup.

if(NOT DEFINED I18N_SOURCE_DIR OR NOT DEFINED I18N_OUTPUT)
    message(FATAL_ERROR "GenerateI18n.cmake needs I18N_SOURCE_DIR and I18N_OUTPUT")
endif()

file(GLOB language_files "${I18N_SOURCE_DIR}/*.csv")
if(NOT language_files)
    message(FATAL_ERROR "no language tables found in ${I18N_SOURCE_DIR}")
endif()

# Sort by $order (padded +1000 so list(SORT) compares numerically for sane orders). Editing a table without
# $order puts it last instead of failing the build.
set(entries "")
foreach(file IN LISTS language_files)
    file(READ "${file}" content)

    if(content MATCHES "^\\$lang:([^\r\n]+)")
        set(code "${CMAKE_MATCH_1}")
    else()
        message(FATAL_ERROR "${file}: missing $lang metadata")
    endif()

    if(content MATCHES "(^|\n)\\$name:([^\r\n]+)")
        set(name "${CMAKE_MATCH_2}")
    else()
        set(name "${code}")
    endif()

    if(content MATCHES "(^|\n)\\$order:([0-9]+)")
        set(order "${CMAKE_MATCH_2}")
    else()
        set(order "999")
    endif()

    if(content MATCHES "\\)sc2csv_i18n\"")
        message(FATAL_ERROR "${file}: contains the raw string terminator")
    endif()

    # Escape for C++ string literals; the CSV body itself stays untouched inside the raw string.
    string(REPLACE "\\" "\\\\" code "${code}")
    string(REPLACE "\"" "\\\"" code "${code}")
    string(REPLACE "\\" "\\\\" name "${name}")
    string(REPLACE "\"" "\\\"" name "${name}")

    math(EXPR sort_key "${order} + 1000")
    list(APPEND entries "${sort_key}|${code}|${name}|${file}")
endforeach()

list(SORT entries)

set(names "")
set(languages "")
foreach(entry IN LISTS entries)
    string(REPLACE "|" ";" parts "${entry}")
    list(GET parts 1 code)
    list(GET parts 2 name)
    list(GET parts 3 file)

    file(READ "${file}" content)

    string(APPEND names "    \"${name}\",\n")
    string(APPEND languages "    {\"${code}\", \"${name}\", R\"sc2csv_i18n(")
    string(APPEND languages "${content}")
    string(APPEND languages ")sc2csv_i18n\"},\n")
endforeach()

get_filename_component(output_dir "${I18N_OUTPUT}" DIRECTORY)
file(MAKE_DIRECTORY "${output_dir}")

set(output "// Generated by cmake/GenerateI18n.cmake from src/i18n/*.csv. Do not edit.\n")
string(APPEND output "#pragma once\n\n#include <cstddef>\n\nnamespace sc2csv::generated {\n\n")
string(APPEND output "struct LanguageSource {\n    const char* code;\n    const char* name;\n    const char* csv;\n};\n\n")
string(APPEND output "// Display names in menu order, matching kLanguages.\n")
string(APPEND output "inline constexpr const char* const kLanguageNames[] = {\n${names}};\n\n")
string(APPEND output "// Every embedded table, in the same order as kLanguageNames.\n")
string(APPEND output "inline constexpr LanguageSource kLanguages[] = {\n${languages}};\n\n")
string(APPEND output "inline constexpr std::size_t kLanguageCount = sizeof(kLanguages) / sizeof(kLanguages[0]);\n\n")
string(APPEND output "static_assert(sizeof(kLanguageNames) / sizeof(kLanguageNames[0]) == kLanguageCount,\n")
string(APPEND output "              \"language names and tables disagree\");\n\n")
string(APPEND output "} // namespace sc2csv::generated\n")

file(WRITE "${I18N_OUTPUT}" "${output}")
